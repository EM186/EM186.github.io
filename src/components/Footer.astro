---
import Icon from './Icon.astro';
import Checker from './Checker.astro';
import Doodle from './Doodle.astro';
import { profile } from '../data/fr';
---
<footer class="contact" id="contact">
  <div class="contact__inner">
    <div class="contact__main">
    <p class="mono contact__k" data-reveal>( contact )</p>
    <h2 class="contact__title" data-reveal>
      <span class="line"><span>On en parle&nbsp;?</span></span>
    </h2>
    <p class="contact__lead" data-reveal>
      Alternance à partir de septembre 2027, stage à l’étranger de juin à août 2027 :
      je réponds vite.
    </p>
    <a class="contact__mail" href={`mailto:${profile.email}`} data-reveal>{profile.email}</a>
    <ul class="contact__links" data-reveal>
      <li><a class="tlink" href={profile.cv} download><Icon name="download" size={16} />CV (PDF)</a></li>
      <li><a class="tlink" href={profile.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} />LinkedIn</a></li>
      <li><a class="tlink" href={profile.github} target="_blank" rel="noopener"><Icon name="github" size={16} />GitHub</a></li>
    </ul>
    <p class="hand contact__ps" data-reveal>
      <Doodle name="arrow-left" size={46} />
      un mail suffit, pas besoin de formulaire
    </p>
    </div>
    <aside class="contact__card" data-reveal>
      <p class="mono contact__card-k">( disponibilités )</p>
      <dl>
        <div><dt class="mono">alternance</dt><dd>dès septembre 2027<br /><span>2 ans · 1 sem. / 1 sem.</span></dd></div>
        <div><dt class="mono">stage</dt><dd>juin à août 2027<br /><span>à l’étranger · 3 mois</span></dd></div>
        <div><dt class="mono">basée à</dt><dd>Lyon<br /><span>Villeurbanne</span></dd></div>
      </dl>
    </aside>
  </div>
  <Checker cols={72} rows={3} seed={17} class="checker--foot" />
  <div class="colophon mono">
    <span>© {new Date().getFullYear()} Emma Zhao</span>
    <span>Lyon · Fait main avec Astro</span>
  </div>
</footer>
