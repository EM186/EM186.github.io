---
/** Petits dessins au trait, volontairement un peu tremblés. */
interface Props { name: 'ball' | 'cup' | 'pencil' | 'cake' | 'arrow' | 'arrow-left' | 'star' | 'cherry'; size?: number; class?: string }
const { name, size = 64, class: cls = '' } = Astro.props;
const d: Record<string, string> = {
  ball: `<circle cx="32" cy="32" r="22.5"/><path d="M14 22c9 3 17 10 20 31M32 9.6c-4 8-4 17 1 25 6 9 15 12 21 11M11 39c8-3 17-2 23 2"/>`,
  cup: `<path d="M14 26h32l-3 20c-1 5-5 8-10 8h-6c-5 0-9-3-10-8z"/><path d="M46 31c6-1 9 2 8 6-1 5-6 6-10 5"/><path d="M10 57c13 2 31 2 44 0"/><path d="M24 20c-2-3 2-5 0-9M32 19c-2-3 2-5 0-9M40 20c-2-3 2-5 0-9"/>`,
  pencil: `<path d="M16 50l4-13 26-26c2-2 6-2 8 0s2 6 0 8L28 45z"/><path d="M20 37l7 8M42 15l7 7"/><path d="M16 50l7-2"/>`,
  cake: `<path d="M10 44l40-16 4 4v18H10z"/><path d="M10 44v6M10 44h44"/><path d="M12 37c4-2 8-1 12-3s9-4 13-5"/><path d="M48 26c0-4 3-6 5-6"/><circle cx="51" cy="20" r="3"/>`,
  arrow: `<path d="M8 40c10-18 30-24 46-14"/><path d="M45 20l9 6-8 7"/>`,
  'arrow-left': `<path d="M56 40C46 22 26 16 10 26"/><path d="M19 20l-9 6 8 7"/>`,
  star: `<path d="M32 10l5 15 15 1-12 9 5 16-13-9-13 9 5-16-12-9 15-1z"/>`,
  cherry: `<circle cx="22" cy="46" r="8"/><circle cx="42" cy="44" r="8"/><path d="M22 38c2-12 8-22 18-27M42 36c-1-10-1-18-2-25"/><path d="M40 11c6-3 12-1 14 4-6 2-11 0-14-4z"/>`,
};
---
<svg class:list={['doodle', cls]} width={size} height={size} viewBox="0 0 64 64" fill="none" stroke="currentColor"
  stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d[name]} />
